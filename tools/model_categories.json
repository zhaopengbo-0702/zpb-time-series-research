{
  "schema_version": 1,
  "classification_policy": "按当前源码的主要建模机制为每个模型家族指定一个主分类。交叉方法只出现一次，次要机制写在简介中；同一模型的独立原版与库内实现共用一个家族条目，源码入口分别保留。分类用于查找，不是性能排名，也不表示模型只使用一种技术。",
  "categories": [
    {
      "id": "linear_mlp",
      "title": "线性与MLP",
      "description": "主要通过线性映射或前馈网络混合时间和变量，适合寻找简单对照与轻量结构。"
    },
    {
      "id": "recurrent_convolution",
      "title": "循环与卷积",
      "description": "以循环状态或局部、多尺度卷积为主要计算结构，也包括先发现周期再做卷积的方法。"
    },
    {
      "id": "transformer_attention",
      "title": "Transformer与注意力",
      "description": "主要围绕 token 表示、注意力连接、稀疏化或输入序列特性改造 Transformer。"
    },
    {
      "id": "decomposition_frequency",
      "title": "分解平滑频域",
      "description": "突出趋势季节分解、指数平滑、频谱或小波处理，可能同时包含注意力或 MLP。"
    },
    {
      "id": "state_space_dynamics",
      "title": "状态空间动力学",
      "description": "以状态递推、动力学算子或连续历史的状态压缩为主要机制。"
    },
    {
      "id": "graph",
      "title": "图结构",
      "description": "重点学习时间片段、通道或多尺度之间的图关系，并通过图传播组织信息。"
    },
    {
      "id": "llm_reprogramming",
      "title": "LLM重编程",
      "description": "把时序输入适配到预训练语言模型，以提示和可训练接口进行预测。"
    },
    {
      "id": "pretrained_foundation",
      "title": "预训练时序模型",
      "description": "库内提供外部预训练时序模型的调用接口，通常用于零样本预测；权重与各自依赖另行获取。"
    },
    {
      "id": "anomaly_specialized",
      "title": "专用异常检测",
      "description": "当前源码重点实现异常检测，不按通用预测模型归类。"
    }
  ],
